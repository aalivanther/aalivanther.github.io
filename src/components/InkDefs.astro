---
// Filtros SVG compartidos de la portada:
// - ink-rough: irregulariza el borde de los iconos para que se lean pintados, no vectoriales.
// - ink-bleed: deforma el borde de la gota de tinta que cubre la pantalla al entrar a una demo.
---

<svg class="ink-defs" aria-hidden="true" focusable="false">
  <filter id="ink-rough" x="-10%" y="-10%" width="120%" height="120%">
    <feTurbulence type="fractalNoise" baseFrequency="1.1" numOctaves="2" seed="3" />
    <feDisplacementMap in="SourceGraphic" scale="1.3" />
  </filter>
  <filter id="ink-bleed">
    <feTurbulence type="fractalNoise" baseFrequency="0.011" numOctaves="3" seed="8" />
    <feDisplacementMap in="SourceGraphic" scale="90" />
  </filter>
</svg>

<style>
  .ink-defs {
    position: absolute;
    width: 0;
    height: 0;
  }
</style>
