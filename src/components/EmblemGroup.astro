---
// Un emblema en tres profundidades: aguada al fondo, tinta en medio y acentos de color al frente.
// Cada lienzo se desplaza con la profundidad compartida de la portada (--sx/--sy) según su --d, así el emblema
// se separa en capas al mover el puntero. scripts/ink/stage.ts reparte los trazos entre los tres.

/** Propiedades del grupo. */
interface Props {
  /** Atributo con el que el script encuentra el grupo («data-ink-group» en escritorio, «data-slide-ink» en móvil). */
  hook: "data-ink-group" | "data-slide-ink";
}

const { hook } = Astro.props;
const attrs = { [hook]: "" };
---

<div class="group" {...attrs}>
  <canvas data-layer="back" data-depth style="--d:0.9" aria-hidden="true"></canvas>
  <canvas data-layer="ink" data-depth style="--d:1.7" aria-hidden="true"></canvas>
  <canvas data-layer="accent" data-depth style="--d:2.6" aria-hidden="true"></canvas>
</div>

<style>
  .group {
    position: absolute;
    inset: 0;
    transform-origin: 55% 52%;
    animation: settle 1.1s var(--ease) both;
    transition:
      opacity 0.9s cubic-bezier(0.4, 0, 0.2, 1),
      filter 0.9s cubic-bezier(0.4, 0, 0.2, 1),
      scale 0.9s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* El grupo que se va se disuelve en el papel: se expande un poco, se difumina y se aclara. */
  .group:global(.is-leaving) {
    opacity: 0;
    filter: blur(10px) contrast(0.85);
    scale: 1.05;
    animation: none;
  }

  @keyframes settle {
    from {
      scale: 0.985;
    }
  }

  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
</style>
