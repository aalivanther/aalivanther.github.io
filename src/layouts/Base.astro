---
// Plantilla común: metadatos, idioma y enlaces hreflang. La portada vive entera dentro de <slot />.
import "../styles/global.css";
import type { Lang } from "../data/projects";
import { projects } from "../data/projects";
import { owner, signature, githubProfile, repoUrl } from "../data/site";
import { ui, homePath, otherLang } from "../i18n/ui";

/** Propiedades que recibe la plantilla. */
interface Props {
  /** Idioma de la página. */
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const alt = otherLang(lang);
// URLs absolutas para canónica y alternativas de idioma (los buscadores las exigen absolutas).
const canonical = new URL(homePath[lang], Astro.site).href;
const alternate = new URL(homePath[alt], Astro.site).href;
const ogLocale = { es: "es_MX", en: "en_US" } as const;
// Imagen para compartir (1200×630) de cada idioma; la genera tools/og.mjs.
const ogImage = new URL(`/og-${lang}.png`, Astro.site).href;

// Datos estructurados: la página es el perfil de su autor y lista los proyectos con su demo y su código.
const profile = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  url: canonical,
  inLanguage: lang === "es" ? "es-MX" : "en",
  name: t.metaTitle,
  description: t.metaDescription,
  mainEntity: {
    "@type": "Person",
    name: signature,
    alternateName: owner,
    url: new URL("/", Astro.site).href,
    sameAs: [githubProfile],
  },
  hasPart: {
    "@type": "ItemList",
    itemListElement: projects.map((p, i) => ({
      "@type": "ListItem",
      position: i + 1,
      item: {
        "@type": "SoftwareSourceCode",
        name: p.name,
        description: p.concept[lang],
        url: new URL(p.demoPath, Astro.site).href,
        codeRepository: repoUrl(p.slug),
        keywords: p.tags.join(", "),
        license: "https://opensource.org/licenses/MIT",
      },
    })),
  },
};
---

<!doctype html>
<html lang={lang === "es" ? "es-MX" : "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{t.metaTitle}</title>
    <meta name="description" content={t.metaDescription} />
    <meta name="theme-color" content="#f4f0e6" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang === "es" ? "es-MX" : "en"} href={canonical} />
    <link rel="alternate" hreflang={alt === "es" ? "es-MX" : "en"} href={alternate} />
    <link rel="alternate" hreflang="x-default" href={new URL("/", Astro.site).href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={t.metaTitle} />
    <meta property="og:description" content={t.metaDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={owner} />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:locale:alternate" content={ogLocale[alt]} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${owner} — ${t.brandLine}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.metaTitle} />
    <meta name="twitter:description" content={t.metaDescription} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="sitemap" href="/sitemap.xml" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(profile)} />
  </head>
  <body>
    <a class="skip" href="#proyectos">{t.skip}</a>
    <slot />
  </body>
</html>
